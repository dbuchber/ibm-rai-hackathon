# BA LiteLLM gateway (OpenRouter behind it), reachable on the Hetzner node
LITELLM_BASE_URL=http://localhost:14000/v1
LITELLM_API_KEY=
RAI_MODEL=openai/mistral-large-4-openrouter
RAI_GRAPH=data/graph/kg.trig
# comma-separated invitation codes for live questions (POST /api/runs, header X-Invite-Code); empty = live closed
RAI_INVITE_CODES=
# reviewer codes (comma separated) unlock curation writes; empty = read-only
RAI_REVIEWER_CODES=
# live answers in a row without an opened source before the chat plants a false fact (POST /api/runs, X-Chat-Session)
RAI_CHAT_CANARY_STREAK=3
# live runs: parallel slots, queue length, runs per client IP and hour
RAI_MAX_LIVE=1
RAI_MAX_QUEUE=20
RAI_RUN_LIMIT=60
