RULE-ST02-04","p":"https://rai-hackathon.bbger.at/ont#defined_in","o":"https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s3","graph":"approved"},{"id":"6a7697a56d5c","s":"https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-01","p":"https://rai-hackathon.bbger.at/ont#defined_in","o":"https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s3","graph":"approved"},{"id":"d064c9857baa","s":"https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s3","p":"https://rai-hackathon.bbger.at/ont#mentions","o":"https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-03","graph":"approved"},{"id":"aabcd37b1e7b","s":"https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s3","p":"https://rai-hackathon.bbger.at/ont#mentions","o":"https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-04","graph":"approved"},{"id":"507fe08e5408","s":"https://rai-hackathon.bbger.at/kg/sensor/SRV01_SERVERROOM_TMP","p":"https://rai-hackathon.bbger.at/ont#of_model","o":"https://rai-hackathon.bbger.at/kg/sensormodel/TMP-2210","graph":"approved"},{"id":"e7deeb06c79c","s":"https://rai-hackathon.bbger.at/kg/document/SOP-001","p":"https://rai-hackathon.bbger.at/ont#has_chunk","o":"https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s3","graph":"approved"},{"id":"86c97a9fac3c","s":"https://rai-hackathon.bbger.at/kg/document/SQA-THERMO-001","p":"https://rai-hackathon.bbger.at/ont#has_chunk","o":"https://rai-hackathon.bbger.at/kg/chunk/SQA-THERMO-001-s2","graph":"approved"}],"nodes":[{"id":"https://rai-hackathon.bbger.at/kg/chunk/SQA-THERMO-001-s3","cls":"Chunk","label":"SQA-THERMO-001 §3. Calibration and Replacement","description":null,"text":"3. Calibration and Replacement. Sensors installed at ST02_SEALING and ST01_FILLING are calibrated every 12 months. ThermoSense replaces a defective TMP-2210 within 5 working days. Drift beyond ±5°C within 500 hours is a warranty case only if the sensor was operated within its rating.","props":{"page":1}},{"id":"https://rai-hackathon.bbger.at/kg/station/ST01_FILLING","cls":"Station","label":"ST01_FILLING","description":"Filling station — liquid product filling","text":null,"props":{"nodeId":"N0009","zone":"Production Area","stationType":"FILLING"}},{"id":"https://rai-hackathon.bbger.at/kg/rule/RULE-THR-ST02-TMP-CRIT","cls":"Rule","label":"RULE-THR-ST02-TMP-CRIT","description":"Temperature critical thresholds: 165.0°C (CRIT_LO), 175.0°C (WARN_LO), 185.0±1.2°C (NOMINAL), 195.0°C (WARN_HI), 210.0°C (CRIT_HI)","text":null,"props":{"severity":"CRITICAL","warnLo":175.0,"action":"E-STOP ST02/ST03/ST04; inspect element","unit":"°C","critHi":210.0,"critLo":165.0,"warnHi":195.0,"ruleClass":"ThresholdRule","sensorType":"TMP"}},{"id":"https://rai-hackathon.bbger.at/kg/chunk/SOP-002-s4","cls":"Chunk","label":"SOP-002 §ST02_SEALING TMP thresholds","description":null,"text":"ST02_SEALING TMP: °C 165.0 175.0 185.0 ± 1.2 195.0 210.0 E-STOP ST02/ST03/ST04; inspect element","props":{"page":1}},{"id":"https://rai-hackathon.bbger.at/kg/sensormodel/TMP-2210","cls":"SensorModel","label":"TMP-2210","description":"Thermocouple temperature sensor, rated 200 °C continuous.","text":null,"props":{"sensorType":"TMP"}},{"id":"https://rai-hackathon.bbger.at/kg/chunk/DS-THERM-2200-s1","cls":"Chunk","label":"DS-THERM-2200 §1. Temperature Sensor TMP-2210 — Specifications","description":null,"text":"1. Temperature Sensor TMP-2210 — Specifications Parameter Value Unit Notes Measurement range -40 to +200 °C Continuous; see note 1 Accuracy (IEC 60584) ±1.5 (class 2) °C At 20°C reference Response time (t90) < 3 s In still air Output signal 4–20 mA Linear to range Max intermittent 220 °C < 10 min; not for control Note 1 — Maximum Operating Temperature: The rated maximum for continuous operation is 200°C. Exposure above this value accelerates thermocouple ageing and may cause drift of up to ±5°C within 500 hours. For applications requiring sustained operation above 200°C, ThermoSense recommends the Series 2400 (Pt100 RTD, rated to 250°C continuous).","props":{"page":1}},{"id":"https://rai-hackathon.bbger.at/kg/document/SOP-002","cls":"Document","label":"SOP-002 Alarm Thresholds and Response Matrix","description":"Alarm Thresholds and Response Matrix — Production Line A","text":null,"props":{"rev":"1.8","author":"Ing. L. Greco — Automation & Control","file":"SOP_002_AlarmThresholds.pdf","date":"2025-10-20"}},{"id":"https://rai-hackathon.bbger.at/kg/sensor/ST01_FILLING_TMP","cls":"Sensor","label":"ST01_FILLING_TMP","description":null,"text":null,"props":{"unit":"°C","critHi":30.0,"warnLo":18.0,"critLo":15.0,"nominalValue":22.0,"sensorType":"TMP","nodeId":"N0010","warnHi":26.0}},{"id":"https://rai-hackathon.bbger.at/kg/document/SQA-THERMO-001","cls":"Document","label":"SQA-THERMO-001 Supplier Quality Agreement with ThermoSense GmbH","description":"Supplier Quality Agreement with ThermoSense GmbH","text":null,"props":{"file":"SQA_ThermoSense.md"}},{"id":"https://rai-hackathon.bbger.at/kg/chunk/SQA-THERMO-001-s1","cls":"Chunk","label":"SQA-THERMO-001 §1. Scope","description":null,"text":"1. Scope. ThermoSense GmbH supplies the temperature sensor TMP-2210 and the humidity sensor HUM-2250 for iMAKS line A. The products conform to datasheet DS-THERM-2200.","props":{"page":1}},{"id":"https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-02","cls":"Rule","label":"RULE-ST02-02","description":"TMP > 210°C (CRITICAL)","text":null,"props":{"critLo":165.0,"action":"Emergency stop ST02, ST03, ST04","warnHi":195.0,"sensorType":"TMP","warnLo":175.0,"severity":"CRITICAL","critHi":210.0,"unit":"°C","ruleClass":"OperationalRule"}},{"id":"https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s3","cls":"Chunk","label":"SOP-001 §2.2 ST02_SEALING","description":null,"text":"2.2 ST02_SEALING RULE-ST02-01: TMP MUST remain between 175°C and 195°C. RULE-ST02-02: TMP > 210°C (CRITICAL) — emergency stop ST02, ST03, ST04. RULE-ST02-03: CUR increase >1.5 A above nominal sustained >5 min — schedule maintenance. RULE-ST02-04: CUR drift at ST02_SEALING CORRELATES with speed reduction at ST04_PACKAGING due to shared electrical coupling. Monitor ST04_PACKAGING-SPD whenever ST02_SEALING-CUR triggers a WARNING.","props":{"page":1}},{"id":"https://rai-hackathon.bbger.at/kg/sensor/ST04_PACKAGING_SPD","cls":"Sensor","label":"ST04_PACKAGING_SPD","description":null,"text":null,"props":{"critLo":0.85,"critHi":1.6,"warnLo":1.0,"warnHi":1.4,"sensorType":"SPD","nominalValue":1.2,"nodeId":"N0024","unit":"m/s"}},{"id":"https://rai-hackathon.bbger.at/kg/sensor/ST02_SEALING_CUR","cls":"Sensor","label":"ST02_SEALING_CUR","description":null,"text":null,"props":{"nodeId":"N0016","critLo":9.5,"nominalValue":12.4,"warnHi":13.5,"critHi":15.0,"unit":"A","warnLo":11.0,"sensorType":"CUR"}},{"id":"https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-01","cls":"Rule","label":"RULE-ST02-01","description":"TMP MUST remain between 175°C and 195°C","text":null,"props":{"action":"Inspect and notify maintenance","warnLo":175.0,"unit":"°C","critHi":210.0,"ruleClass":"OperationalRule","severity":"MANDATORY","sensorType":"TMP","critLo":165.0,"warnHi":195.0}},{"id":"https://rai-hackathon.bbger.at/kg/station/ST02_SEALING","cls":"Station","label":"ST02_SEALING","description":"Sealing station — thermal sealing of packages","text":null,"props":{"stationType":"SEALING","nodeId":"N0013","zone":"Production Area"}},{"id":"https://rai-hackathon.bbger.at/kg/station/ST04_PACKAGING","cls":"Station","label":"ST04_PACKAGING","description":"Packaging station — final boxing and conveyor","text":null,"props":{"nodeId":"N0021","stationType":"PACKAGING","zone":"Production Area"}},{"id":"https://rai-hackathon.bbger.at/kg/chunk/SQA-THERMO-001-s2","cls":"Chunk","label":"SQA-THERMO-001 §2. Warranty Conditions","description":null,"text":"2. Warranty Conditions. The warranty for TMP-2210 covers continuous operation up to 200°C, as stated in DS-THERM-2200. Operation above 200°C voids the warranty for drift caused by thermocouple ageing. The Buyer is responsible for process limits at ST02_SEALING that respect this rating.","props":{"page":1}},{"id":"https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-03","cls":"Rule","label":"RULE-ST02-03","description":"CUR increase >1.5 A above nominal sustained >5 min","text":null,"props":{"action":"Schedule maintenance","critLo":9.5,"warnLo":11.0,"ruleClass":"OperationalRule","sensorType":"CUR","warnHi":13.5,"critHi":15.0,"unit":"A","severity":"WARNING"}},{"id":"https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-04","cls":"Rule","label":"RULE-ST02-04","description":"CUR drift at ST02_SEALING CORRELATES with speed reduction at ST04_PACKAGING","text":null,"props":{"critHi":15.0,"unit":"A","warnLo":11.0,"action":"Monitor ST04_PACKAGING-SPD whenever ST02_SEALING-CUR triggers WARNING","warnHi":13.5,"ruleClass":"OperationalRule","severity":"WARNING","sensorType":"CUR","critLo":9.5}},{"id":"https://rai-hackathon.bbger.at/kg/sensor/SRV01_SERVERROOM_TMP","cls":"Sensor","label":"SRV01_SERVERROOM_TMP","description":null,"text":null,"props":{"unit":"°C","critHi":28.0,"nodeId":"N0026","warnHi":25.0,"warnLo":18.0,"critLo":16.0,"sensorType":"TMP","nominalValue":21.0}},{"id":"https://rai-hackathon.bbger.at/kg/document/SOP-001","cls":"Document","label":"SOP-001 Standard Operating Procedures","description":"Standard Operating Procedures — Production Line A","text":null,"props":{"rev":"2.3","author":"Ing. M. Bianchi — Process Engineering","file":"SOP_001_OperatingProcedures.pdf","date":"2025-11-15"}}],"decisions":[{"edge_id":"7d7fdf5127b2","verdict":"prune","reason":"Step evaluation failed (unusable LLM output); pruned."},{"edge_id":"47d7973d645b","verdict":"prune","reason":"Step evaluation failed (unusable LLM output); pruned."},{"edge_id":"3f5158dd4124","verdict":"prune","reason":"Step evaluation failed (unusable LLM output); pruned."},{"edge_id":"984875e3c22d","verdict":"prune","reason":"Step evaluation failed (unusable LLM output); pruned."},{"edge_id":"c70ad22a8087","verdict":"prune","reason":"Step evaluation failed (unusable LLM output); pruned."},{"edge_id":"0c38a9fc0ca3","verdict":"prune","r