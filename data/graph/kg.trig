            <https://rai-hackathon.bbger.at/kg/station/SRV01_SERVERROOM> ;
        ns1:page 2 ;
        ns1:text "2.5 SRV01_SERVERROOM RULE-SRV01-01: TMP MUST NOT exceed 25°C. RULE-SRV01-02: TMP > 28°C (CRITICAL) — automatic controlled shutdown of all PLC nodes." .

    <https://rai-hackathon.bbger.at/kg/chunk/SOP-002-s2> a ns1:Chunk ;
