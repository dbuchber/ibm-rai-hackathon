    <https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s2> a ns1:Chunk ;
        rdfs:label "SOP-001 §2.1 ST01_FILLING" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/rule/RULE-ST01-01>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-ST01-02>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-ST01-03>,
            <https://rai-hackathon.bbger.at/kg/sensor/ST01_FILLING_FLW>,
            <https://rai-hackathon.bbger.at/kg/sensor/ST01_FILLING_PRS>,
            <https://rai-hackathon.bbger.at/kg/sensor/ST01_FILLING_TMP>,
            <https://rai-hackathon.bbger.at/kg/station/ST01_FILLING> ;
        ns1:page 1 ;
        ns1:text "2.1 ST01_FILLING RULE-ST01-01: FLW MUST be maintained between 112 and 128 L/min. RULE-ST01-02: If TMP exceeds 26°C, reduce speed by 10% and notify QC. RULE-ST01-03: PRS drop below 3.3 bar — inspect inlet valve within 5 min." .

    <https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s5> a ns1:Chunk ;
        rdfs:label "SOP-001 §2.4 ST04_PACKAGING" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-04>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-ST04-01>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-ST04-02>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-ST04-03>,
            <https://rai-hackathon.bbger.at/kg/sensor/ST04_PACKAGING_SPD>,
            <https://rai-hackathon.bbger.at/kg/sensor/ST04_PACKAGING_VIB>,
            <https://rai-hackathon.bbger.at/kg/station/ST04_PACKAGING> ;
        ns1:page 1 ;
        ns1:text "2.4 ST04_PACKAGING RULE-ST04-01: VIB > 0.20 mm/s (WARNING) — schedule maintenance within 24 h. RULE-ST04-02: VIB > 0.35 mm/s (CRITICAL) — emergency stop; inspect bearings. RULE-ST04-03: SPD drops below 1.00 m/s without operator command — verify RULE-ST02-04." .

    <https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s7> a ns1:Chunk ;
        rdfs:label "SOP-001 §2.6 WRH01_WAREHOUSE (General Warehouse)" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/rule/RULE-WRH01-02>,
            <https://rai-hackathon.bbger.at/kg/sensor/WRH01_WAREHOUSE_HUM>,
            <https://rai-hackathon.bbger.at/kg/sensor/WRH01_WAREHOUSE_TMP>,
            <https://rai-hackathon.bbger.at/kg/station/WRH01_WAREHOUSE>,
            <https://rai-hackathon.bbger.at/kg/zone/General_Warehouse> ;
        ns1:page 2 ;
        ns1:text "2.6 WRH01_WAREHOUSE (General Warehouse) RULE-WRH01-01: TMP MUST remain between 0.5°C and 8°C. CRITICAL above 12°C — notify QC and quarantine batch. RULE-WRH01-02: HUM above 85%RH — inspect door seals and activate dehumidifier." .

    <https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s9> a ns1:Chunk ;
        rdfs:label "SOP-001 §2.8 RND01_RDLAB (R&D Lab)" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/rule/RULE-RND01-01>,
            <https://rai-hackathon.bbger.at/kg/sensor/RND01_RDLAB_HUM>,
            <https://rai-hackathon.bbger.at/kg/sensor/RND01_RDLAB_TMP>,
            <https://rai-hackathon.bbger.at/kg/station/RND01_RDLAB>,
            <https://rai-hackathon.bbger.at/kg/zone/R_D_Lab> ;
        ns1:page 2 ;
        ns1:text "2.8 RND01_RDLAB (R&D Lab) RULE-RND01-01: TMP MUST remain between 18°C and 26°C for experimental validity. RULE-RND01-02: HUM drift above 65%RH — activate dehumidifier. Above 75%RH (CRITICAL) — suspend sensitive experiments and inspect HVAC system." .

    <https://rai-hackathon.bbger.at/kg/chunk/SOP-003-s9> a ns1:Chunk ;
        rdfs:label "SOP-003 §2. Correlated Fault Resolution" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/sensor/ST02_SEALING_CUR>,
            <https://rai-hackathon.bbger.at/kg/zone/Server_Room> ;
        ns1:page 1 ;
        ns1:text "2. Correlated Fault Resolution Pattern Primary Fault Secondary Effect Resolution ST02_SEALING-CUR↑ → ST04_PACKAGING- SPD↓ Sealing motor overload Conveyor speed drop via electrical coupling 1.Verify ST02-CUR trend. 2.Inspect sealing jaw. 3.Reset ST04 speed setpoint. SRV01-TMP↑ → SCADA latency↑ Server Room overheating Increased scan time → apparent STUCK readings 1.Reduce SRV01-TMP <25°C. 2.Verify PLC heartbeats. 3.Clear STUCK alarms. WRH01-TMP↑ → QC HOLD Cold warehouse drift Product quality risk 1.Restore WRH01-TMP <8°C. 2.Notify QC. 3.Place batch on HOLD in ERP." .

    <https://rai-hackathon.bbger.at/kg/role/manager> a ns1:Role ;
        rdfs:label "manager" ;
