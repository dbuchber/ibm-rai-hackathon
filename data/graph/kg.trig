    <https://rai-hackathon.bbger.at/kg/chunk/DS-MECH-4400-s2> a ns1:Chunk ;
        rdfs:label "DS-MECH-4400 §2. Electromagnetic Flowmeter FLW-4450" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/sensormodel/FLW-4450> ;
        ns1:page 1 ;
        ns1:text "2. Electromagnetic Flowmeter FLW-4450 Parameter Value Unit Measuring range 0 to 500 L/min Accuracy ±0.5% of reading — Max fluid temp +80 °C" .

    <https://rai-hackathon.bbger.at/kg/chunk/DS-MECH-4400-s3> a ns1:Chunk ;
        rdfs:label "DS-MECH-4400 §3. Piezoelectric Accelerometer VIB-4480" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/sensormodel/VIB-4480> ;
        ns1:page 1 ;
        ns1:text "3. Piezoelectric Accelerometer VIB-4480 Parameter Value Unit Measuring range 0 to 50 mm/s RMS Frequency range 10 to 1000 Hz Accuracy ±3% of reading Resonant frequency ≥ 18 kHz" .

    <https://rai-hackathon.bbger.at/kg/chunk/DS-MECH-4400-s4> a ns1:Chunk ;
        rdfs:label "DS-MECH-4400 §4. Inductive Speed Encoder SPD-4490" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/sensormodel/SPD-4490> ;
        ns1:page 1 ;
        ns1:text "4. Inductive Speed Encoder SPD-4490 Parameter Value Unit Speed range 0.1 to 10 m/s Resolution 0.001 m/s Max amb. temp 80 °C" .

    <https://rai-hackathon.bbger.at/kg/chunk/DS-THERM-2200-s2> a ns1:Chunk ;
        rdfs:label "DS-THERM-2200 §2. Humidity Sensor HUM-2250 — Specifications" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/sensormodel/HUM-2250> ;
        ns1:page 1 ;
        ns1:text "2. Humidity Sensor HUM-2250 — Specifications Parameter Value Unit Measurement range 0 to 100 %RH Accuracy ±2.0 %RH Operating temp -20 to +60 °C Response time < 8 s" .

    <https://rai-hackathon.bbger.at/kg/chunk/MC-2026-01-s1> a ns1:Chunk ;
        rdfs:label "MC-2026-01 §1. Scope" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/maintenance/MAINT-01>,
            <https://rai-hackathon.bbger.at/kg/maintenance/MAINT-02>,
            <https://rai-hackathon.bbger.at/kg/rule/MAINT-01>,
            <https://rai-hackathon.bbger.at/kg/rule/MAINT-02>,
            <https://rai-hackathon.bbger.at/kg/station/ST02_SEALING>,
            <https://rai-hackathon.bbger.at/kg/station/ST04_PACKAGING> ;
        ns1:page 1 ;
        ns1:text "1. Scope. The service provider performs the predictive maintenance actions MAINT-01 and MAINT-02 on ST04_PACKAGING and ST02_SEALING, as defined in SOP-003." .

    <https://rai-hackathon.bbger.at/kg/chunk/MC-2026-01-s2> a ns1:Chunk ;
        rdfs:label "MC-2026-01 §2. Response Times" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/maintenance/MAINT-02>,
            <https://rai-hackathon.bbger.at/kg/rule/MAINT-02>,
            <https://rai-hackathon.bbger.at/kg/station/ST02_SEALING> ;
        ns1:page 1 ;
        ns1:text "2. Response Times. For CRITICAL alarms at ST02_SEALING the provider is on site within 4 hours. For HIGH priority actions such as MAINT-02 (sealing jaw inspection) the provider responds within 2 working days." .

    <https://rai-hackathon.bbger.at/kg/chunk/MC-2026-01-s3> a ns1:Chunk ;
        rdfs:label "MC-2026-01 §3. Spare Parts" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/sensormodel/TMP-2210> ;
        ns1:page 1 ;
        ns1:text "3. Spare Parts. Kelvara keeps a stock of TMP-2210 sensors and sealing jaw elements. Spare sensors are ordered from ThermoSense GmbH." .

    <https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s1> a ns1:Chunk ;
        rdfs:label "SOP-001 §1. Station Dependencies" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/station/CAF01_CAFETERIA>,
            <https://rai-hackathon.bbger.at/kg/station/CHM01_CHEMICALSTORAGE>,
            <https://rai-hackathon.bbger.at/kg/station/RND01_RDLAB>,
            <https://rai-hackathon.bbger.at/kg/station/SRV01_SERVERROOM>,
            <https://rai-hackathon.bbger.at/kg/station/ST01_FILLING>,
            <https://rai-hackathon.bbger.at/kg/station/ST02_SEALING>,
            <https://rai-hackathon.bbger.at/kg/station/ST03_LABELLING>,
            <https://rai-hackathon.bbger.at/kg/station/ST04_PACKAGING>,
            <https://rai-hackathon.bbger.at/kg/station/WRH01_WAREHOUSE>,
            <https://rai-hackathon.bbger.at/kg/zone/Cafeteria>,
            <https://rai-hackathon.bbger.at/kg/zone/Chemical_Storage>,
            <https://rai-hackathon.bbger.at/kg/zone/General_Warehouse>,
            <https://rai-hackathon.bbger.at/kg/zone/Production_Area>,
            <https://rai-hackathon.bbger.at/kg/zone/R_D_Lab>,
            <https://rai-hackathon.bbger.at/kg/zone/Server_Room> ;
        ns1:page 1 ;
        ns1:text "1. Station Dependencies ST01_FILLING → ST02_SEALING → ST03_LABELLING → ST04_PACKAGING. A fault at any station propagates downstream unless the line is halted. Station ID Zone Depends On Downstream Effect ST01_FILLING Production Area — Feeds ST02_SEALING ST02_SEALING Production Area ST01 Feeds ST03; thermal fault → ST04 speed reduction ST03_LABELLING Production Area ST02 Feeds ST04_PACKAGING ST04_PACKAGING Production Area ST03 Final output SRV01_SERVERROOM Server Room HVAC SCADA control; failure → line halt WRH01_WAREHOUSE General Warehouse COMPRESSOR Cold storage — product quality CHM01_CHEMICALSTORAGE Chemical Storage HVAC Hazardous materials — safety critical RND01_RDLAB R&D Lab HVAC Precision experiments — climate sensitive CAF01_CAFETERIA Cafeteria HVAC Occupant comfort — food safety" .

    <https://rai-hackathon.bbger.at/kg/chunk/SOP-004-s1> a ns1:Chunk ;
        rdfs:label "SOP-004 §1. Role-Zone Authorisation Matrix" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/zone/Cafeteria>,
            <https://rai-hackathon.bbger.at/kg/zone/R_D_Lab>,
            <https://rai-hackathon.bbger.at/kg/zone/Server_Room> ;
        ns1:page 1 ;
        ns1:text "1. Role-Zone Authorisation Matrix Role Prod. Area Server Room Gen. Warehous e Main Entranc e Chem. Stora ge R&D Lab Cafeteria operator YES NO YES YES NO NO YES technician YES YES YES YES YES YES YES supervisor YES YES YES YES YES YES YES manager YES YES YES YES YES YES YES security YES YES YES YES YES YES YES visitor YES NO NO YES NO NO YES" .

    <https://rai-hackathon.bbger.at/kg/chunk/SQA-THERMO-001-s1> a ns1:Chunk ;
        rdfs:label "SQA-THERMO-001 §1. Scope" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/sensormodel/HUM-2250>,
            <https://rai-hackathon.bbger.at/kg/sensormodel/TMP-2210> ;
        ns1:page 1 ;
        ns1:text "1. Scope. ThermoSense GmbH supplies the temperature sensor TMP-2210 and the humidity sensor HUM-2250 for iMAKS line A. The products conform to datasheet DS-THERM-2200." .

    <https://rai-hackathon.bbger.at/kg/chunk/SQA-THERMO-001-s2> a ns1:Chunk ;
        rdfs:label "SQA-THERMO-001 §2. Warranty Conditions" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/sensormodel/TMP-2210>,
            <https://rai-hackathon.bbger.at/kg/station/ST02_SEALING> ;
        ns1:page 1 ;
        ns1:text "2. Warranty Conditions. The warranty for TMP-2210 covers continuous operation up to 200°C, as stated in DS-THERM-2200. Operation above 200°C voids the warranty for drift caused by thermocouple ageing. The Buyer is responsible for process limits at ST02_SEALING that respect this rating." .

    <https://rai-hackathon.bbger.at/kg/chunk/SQA-THERMO-001-s3> a ns1:Chunk ;
        rdfs:label "SQA-THERMO-001 §3. Calibration and Replacement" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/sensormodel/TMP-2210>,
            <https://rai-hackathon.bbger.at/kg/station/ST01_FILLING>,
            <https://rai-hackathon.bbger.at/kg/station/ST02_SEALING> ;
        ns1:page 1 ;
        ns1:text "3. Calibration and Replacement. Sensors installed at ST02_SEALING and ST01_FILLING are calibrated every 12 months. ThermoSense replaces a defective TMP-2210 within 5 working days. Drift beyond ±5°C within 500 hours is a warranty case only if the sensor was operated within its rating." .

    <https://rai-hackathon.bbger.at/kg/document/MC-2026-01> a ns1:Document ;
