    <https://rai-hackathon.bbger.at/kg/chunk/DS-THERM-2200-s1> a ns1:Chunk ;
        rdfs:label "DS-THERM-2200 §1. Temperature Sensor TMP-2210 — Specifications" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/sensormodel/TMP-2210> ;
        ns1:page 1 ;
        ns1:text "1. Temperature Sensor TMP-2210 — Specifications Parameter Value Unit Notes Measurement range -40 to +200 °C Continuous; see note 1 Accuracy (IEC 60584) ±1.5 (class 2) °C At 20°C reference Response time (t90) < 3 s In still air Output signal 4–20 mA Linear to range Max intermittent 220 °C < 10 min; not for control Note 1 — Maximum Operating Temperature: The rated maximum for continuous operation is 200°C. Exposure above this value accelerates thermocouple ageing and may cause drift of up to ±5°C within 500 hours. For applications requiring sustained operation above 200°C, ThermoSense recommends the Series 2400 (Pt100 RTD, rated to 250°C continuous)." .

    <https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s10> a ns1:Chunk ;
        rdfs:label "SOP-001 §2.9 CAF01_CAFETERIA" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/rule/RULE-CAF01-01>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-CAF01-02>,
            <https://rai-hackathon.bbger.at/kg/sensor/CAF01_CAFETERIA_HUM>,
            <https://rai-hackathon.bbger.at/kg/sensor/CAF01_CAFETERIA_TMP>,
            <https://rai-hackathon.bbger.at/kg/station/CAF01_CAFETERIA> ;
        ns1:page 2 ;
        ns1:text "2.9 CAF01_CAFETERIA RULE-CAF01-01: TMP above 26°C — check ventilation system. Occupant comfort is the primary criterion. RULE-CAF01-02: HUM above 70%RH — inspect drainage and activate ventilation." .

    <https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s6> a ns1:Chunk ;
        rdfs:label "SOP-001 §2.5 SRV01_SERVERROOM" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/rule/RULE-SRV01-01>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-SRV01-02>,
