    <https://rai-hackathon.bbger.at/kg/rule/RULE-ACK-MAN-CRIT> a ns1:Rule ;
        rdfs:label "RULE-ACK-MAN-CRIT" ;
        rdfs:comment "manager role — CRITICAL alarm acknowledgment" ;
        ns1:action "Must acknowledge within 5 minutes" ;
        ns1:defined_in <https://rai-hackathon.bbger.at/kg/chunk/SOP-004-s3> ;
        ns1:ruleClass "AccessRule" ;
        ns1:severity "MANDATORY" ;
        ns1:unit "min" .

