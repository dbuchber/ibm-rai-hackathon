    <https://rai-hackathon.bbger.at/kg/rule/MAINT-02> a ns1:Rule ;
        rdfs:label "MAINT-02" ;
        rdfs:comment "CUR DRIFT >1.0 A for 30+ min" ;
        ns1:action "Inspect sealing jaw alignment" ;
        ns1:applies_to <https://rai-hackathon.bbger.at/kg/sensor/ST02_SEALING_CUR>,
            <https://rai-hackathon.bbger.at/kg/station/ST02_SEALING> ;
        ns1:defined_in <https://rai-hackathon.bbger.at/kg/chunk/SOP-003-s2> ;
        ns1:ruleClass "MaintenanceRule" ;
        ns1:sensorType "CUR" ;
        ns1:severity "HIGH" ;
        ns1:unit "A" .

    <https://rai-hackathon.bbger.at/kg/rule/MAINT-03> a ns1:Rule ;
        rdfs:label "MAINT-03" ;
        rdfs:comment "TEN STUCK >10 consecutive samples" ;
        ns1:action "Replace TEN sensor" ;
        ns1:applies_to <https://rai-hackathon.bbger.at/kg/sensor/ST03_LABELLING_TEN>,
            <https://rai-hackathon.bbger.at/kg/station/ST03_LABELLING> ;
        ns1:defined_in <https://rai-hackathon.bbger.at/kg/chunk/SOP-003-s3> ;
        ns1:ruleClass "MaintenanceRule" ;
        ns1:sensorType "TEN" ;
        ns1:severity "MEDIUM" ;
        ns1:unit "N" .

    <https://rai-hackathon.bbger.at/kg/rule/MAINT-05> a ns1:Rule ;
        rdfs:label "MAINT-05" ;
        rdfs:comment "TMP >25°C for >5 min" ;
        ns1:action "Activate secondary cooling" ;
        ns1:applies_to <https://rai-hackathon.bbger.at/kg/sensor/SRV01_SERVERROOM_TMP>,
            <https://rai-hackathon.bbger.at/kg/station/SRV01_SERVERROOM> ;
        ns1:defined_in <https://rai-hackathon.bbger.at/kg/chunk/SOP-003-s5> ;
        ns1:ruleClass "MaintenanceRule" ;
        ns1:sensorType "TMP" ;
        ns1:severity "CRITICAL" ;
        ns1:unit "°C" .

    <https://rai-hackathon.bbger.at/kg/rule/MAINT-06> a ns1:Rule ;
        rdfs:label "MAINT-06" ;
        rdfs:comment "TMP DRIFT >2°C over 2 h" ;
        ns1:action "Inspect compressor; notify QC" ;
        ns1:applies_to <https://rai-hackathon.bbger.at/kg/sensor/WRH01_WAREHOUSE_TMP>,
            <https://rai-hackathon.bbger.at/kg/station/WRH01_WAREHOUSE> ;
        ns1:defined_in <https://rai-hackathon.bbger.at/kg/chunk/SOP-003-s6> ;
        ns1:ruleClass "MaintenanceRule" ;
        ns1:sensorType "TMP" ;
        ns1:severity "CRITICAL" ;
        ns1:unit "°C" .

    <https://rai-hackathon.bbger.at/kg/rule/MAINT-07> a ns1:Rule ;
        rdfs:label "MAINT-07" ;
        rdfs:comment "TMP >20°C for >10 min" ;
        ns1:action "Emergency ventilation; notify safety officer" ;
        ns1:applies_to <https://rai-hackathon.bbger.at/kg/sensor/CHM01_CHEMICALSTORAGE_TMP>,
            <https://rai-hackathon.bbger.at/kg/station/CHM01_CHEMICALSTORAGE> ;
        ns1:defined_in <https://rai-hackathon.bbger.at/kg/chunk/SOP-003-s7> ;
        ns1:ruleClass "MaintenanceRule" ;
        ns1:sensorType "TMP" ;
        ns1:severity "CRITICAL" ;
        ns1:unit "°C" .

    <https://rai-hackathon.bbger.at/kg/rule/MAINT-08> a ns1:Rule ;
        rdfs:label "MAINT-08" ;
        rdfs:comment "HUM DRIFT >10%RH over 60 min" ;
