        ns1:triggers <https://rai-hackathon.bbger.at/kg/anomalyevent/N0049> ;
        ns1:unit "pcs/min" ;
        ns1:warnHi 130 ;
        ns1:warnLo 110 .

    <https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s3> a ns1:Chunk ;
        rdfs:label "SOP-001 §2.2 ST02_SEALING" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-01>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-02>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-03>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-04>,
            <https://rai-hackathon.bbger.at/kg/sensor/ST02_SEALING_CUR>,
            <https://rai-hackathon.bbger.at/kg/sensor/ST02_SEALING_TMP>,
            <https://rai-hackathon.bbger.at/kg/sensor/ST04_PACKAGING_SPD>,
            <https://rai-hackathon.bbger.at/kg/station/ST02_SEALING>,
            <https://rai-hackathon.bbger.at/kg/station/ST04_PACKAGING> ;
        ns1:page 1 ;
        ns1:text "2.2 ST02_SEALING RULE-ST02-01: TMP MUST remain between 175°C and 195°C. RULE-ST02-02: TMP > 210°C (CRITICAL) — emergency stop ST02, ST03, ST04. RULE-ST02-03: CUR increase >1.5 A above nominal sustained >5 min — schedule maintenance. RULE-ST02-04: CUR drift at ST02_SEALING CORRELATES with speed reduction at ST04_PACKAGING due to shared electrical coupling. Monitor ST04_PACKAGING-SPD whenever ST02_SEALING-CUR triggers a WARNING." .

    <https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s8> a ns1:Chunk ;
        rdfs:label "SOP-001 §2.7 CHM01_CHEMICALSTORAGE (Chemical Storage)" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/rule/RULE-CHM01-03>,
            <https://rai-hackathon.bbger.at/kg/sensor/CHM01_CHEMICALSTORAGE_HUM>,
            <https://rai-hackathon.bbger.at/kg/sensor/CHM01_CHEMICALSTORAGE_TMP>,
            <https://rai-hackathon.bbger.at/kg/station/CHM01_CHEMICALSTORAGE>,
            <https://rai-hackathon.bbger.at/kg/zone/Chemical_Storage> ;
        ns1:page 2 ;
        ns1:text "2.7 CHM01_CHEMICALSTORAGE (Chemical Storage) RULE-CHM01-01: TMP MUST remain between 10°C and 20°C. CRITICAL above 25°C — activate emergency ventilation and notify safety officer immediately. RULE-CHM01-02: HUM MUST NOT exceed 50%RH. Elevated humidity accelerates degradation of hygroscopic reagents. Activate desiccant system if HUM >45%RH. RULE-CHM01-03: Only personnel with hazmat training (technician/supervisor/manager role) are authorised to enter Chemical Storage. UNAUTHORIZED_ACCESS must be escalated within 2 minutes." .

    <https://rai-hackathon.bbger.at/kg/chunk/SOP-002-s23> a ns1:Chunk ;
        rdfs:label "SOP-002 §Anomaly Type Definitions" ;
        ns1:page 2 ;
        ns1:text "Anomaly Type Definitions for KG Mapping Type Definition Detection Criterion Ontology Class SPIKE Transient deviation >3σ, <5 min Single reading >CRIT AnomalyEvent::Spike DRIFT Monotonic deviation >15 min Slope >0.1σ/min for 5+ readings AnomalyEvent::Drift STUCK Unchanged >10 consecutive readings std(last 10)<0.001×nominal AnomalyEvent::StuckSensor OUT_OF_RAN GE Sustained WARN violation >10 min >WARN for 20+ readings AnomalyEvent::OutOfRange CORRELATED Causally linked to another station Onset within 90 min of cause AnomalyEvent::Correlated" .

