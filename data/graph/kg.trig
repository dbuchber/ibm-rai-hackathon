    <https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s3> a ns1:Chunk ;
        rdfs:label "SOP-001 §2.2 ST02_SEALING" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-01>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-02>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-03>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-ST02-04>,
            <https://rai-hackathon.bbger.at/kg/sensor/ST02_SEALING_CUR>,
            <https://rai-hackathon.bbger.at/kg/sensor/ST02_SEALING_TMP>,
            <https://rai-hackathon.bbger.at/kg/sensor/ST04_PACKAGING_SPD>,
            <https://rai-hackathon.bbger.at/kg/station/ST02_SEALING>,
            <https://rai-hackathon.bbger.at/kg/station/ST04_PACKAGING> ;
        ns1:page 1 ;
        ns1:text "2.2 ST02_SEALING RULE-ST02-01: TMP MUST remain between 175°C and 195°C. RULE-ST02-02: TMP > 210°C (CRITICAL) — emergency stop ST02, ST03, ST04. RULE-ST02-03: CUR increase >1.5 A above nominal sustained >5 min — schedule maintenance. RULE-ST02-04: CUR drift at ST02_SEALING CORRELATES with speed reduction at ST04_PACKAGING due to shared electrical coupling. Monitor ST04_PACKAGING-SPD whenever ST02_SEALING-CUR triggers a WARNING." .

    <https://rai-hackathon.bbger.at/kg/chunk/SOP-001-s4> a ns1:Chunk ;
        rdfs:label "SOP-001 §2.3 ST03_LABELLING" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/rule/RULE-ST03-01>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-ST03-03>,
            <https://rai-hackathon.bbger.at/kg/sensor/ST03_LABELLING_CNT>,
            <https://rai-hackathon.bbger.at/kg/sensor/ST03_LABELLING_TEN>,
            <https://rai-hackathon.bbger.at/kg/station/ST03_LABELLING> ;
        ns1:page 1 ;
        ns1:text "2.3 ST03_LABELLING RULE-ST03-01: TEN MUST be between 1.8 and 2.6 N. RULE-ST03-02: CNT below 110 pcs/min — check for label jam. Below 100 (CRITICAL): halt. RULE-ST03-03: TEN STUCK >10 consecutive samples — sensor failure." .

    <https://rai-hackathon.bbger.at/kg/chunk/SOP-004-s4> a ns1:Chunk ;
        rdfs:label "SOP-004 §4. Unauthorised Access Rules" ;
        ns1:mentions <https://rai-hackathon.bbger.at/kg/rule/RULE-ACCESS-01>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-ACCESS-02>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-ACCESS-03>,
            <https://rai-hackathon.bbger.at/kg/rule/RULE-ACCESS-04>,
            <https://rai-hackathon.bbger.at/kg/zone/Chemical_Storage> ;
        ns1:page 1 ;
        ns1:text "4. Unauthorised Access Rules RULE-ACCESS-01: Any entry by an unauthorised role MUST be logged as OccupancyEvent::UnauthorisedAccess with person_id, zone, and timestamp. RULE-ACCESS-02: Security personnel MUST be notified within 2 minutes of detection. RULE-ACCESS-03: The KG node MUST include authorized=NO and a reference to this rule. RULE-ACCESS-04: Chemical Storage has zero-tolerance policy. Any UNAUTHORIZED_ACCESS triggers immediate escalation to the Safety Officer regardless of role." .

    <https://rai-hackathon.bbger.at/kg/maintenance/MAINT-04> a ns1:Maintenance ;
        rdfs:label "MAINT-04: Inspect inlet filter and pump" ;
        ns1:action "Inspect inlet filter and pump" ;
        ns1:nodeId "N0057" ;
        ns1:priority "MEDIUM" ;
        ns1:resolves <https://rai-hackathon.bbger.at/kg/sensor/ST01_FILLING_PRS> ;
        ns1:ruleId "MAINT-04" .

    <https://rai-hackathon.bbger.at/kg/sensor/CHM01_CHEMICALSTORAGE_HUM> a ns1:Sensor ;
        rdfs:label "CHM01_CHEMICALSTORAGE_HUM" ;
        ns1:critHi 6e+01 ;
        ns1:critLo 1.5e+01 ;
        ns1:monitors <https://rai-hackathon.bbger.at/kg/station/CHM01_CHEMICALSTORAGE> ;
